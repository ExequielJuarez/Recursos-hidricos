<%
  // Menú lateral: solo en celular y tablet (en escritorio la navegación está en la barra superior, ver topbar.ejs)
  const _nav = (typeof navegacion !== 'undefined') ? navegacion : require('../../utils/navegacion');
  const _usr = (typeof usuarioLocal !== 'undefined') ? usuarioLocal : null;
  const _secciones = _nav.seccionesVisibles(_usr);
  const _ubic = _nav.ubicar(typeof currentPath !== 'undefined' ? currentPath : '', _secciones);
%>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

  :root {
    --rh-navy: #0d1b2e;
    --rh-navy-2: #13253d;
    --rh-line: rgba(255, 255, 255, 0.09);
    --rh-text: #cbd5e1;
    --rh-muted: #8193ab;
    --rh-active-bg: rgba(59, 130, 246, 0.16);
    --rh-active-border: rgba(96, 165, 250, 0.45);
  }

  /* El contenido ocupa todo el ancho: ya no hay barra lateral fija */
  body .app-wrapper { margin-left: 0 !important; width: 100% !important; }

  #mi-sidebar-blindado {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 9999;
    width: 290px; max-width: 86vw;
    background: linear-gradient(180deg, var(--rh-navy) 0%, var(--rh-navy-2) 100%);
    font-family: 'DM Sans', sans-serif;
    display: flex; flex-direction: column;
    border-right: 1px solid var(--rh-line);
    transform: translateX(-100%); transition: transform 0.28s ease;
    box-shadow: 8px 0 30px rgba(2, 8, 23, 0.35);
  }
  #mi-sidebar-blindado.abierto { transform: translateX(0); }

  .sb-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 14px 14px 18px; border-bottom: 1px solid var(--rh-line); flex-shrink: 0; }
  .sb-header img { height: 44px; width: auto; display: block; }
  .sb-close { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--rh-line); background: rgba(255,255,255,0.05); color: var(--rh-text); display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .sb-close svg { width: 18px; height: 18px; }

  .sb-nav { padding: 14px 12px 24px; flex: 1; overflow-y: auto; }
  .sb-nav::-webkit-scrollbar { width: 4px; }
  .sb-nav::-webkit-scrollbar-thumb { background-color: #2b3d57; border-radius: 10px; }
  .sb-label { display: block; padding: 0 10px; margin: 6px 0 10px; font-size: 10.5px; font-weight: 800; color: var(--rh-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .sb-ul { list-style: none; padding: 0; margin: 0; }
  .sb-li { margin-bottom: 4px; }

  .sb-link {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 11px 12px; border-radius: 10px; border: 1px solid transparent;
    background: none; color: var(--rh-text); text-decoration: none; text-align: left;
    font: 600 15px 'DM Sans', sans-serif; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .sb-link:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
  .sb-icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--rh-muted); fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .sb-link:hover .sb-icon { color: #e2e8f0; }
  .sb-chevron { width: 16px; height: 16px; margin-left: auto; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.6; transition: transform 0.25s; }
  .sb-li.abierto .sb-chevron { transform: rotate(180deg); opacity: 1; }

  .sb-submenu { list-style: none; margin: 4px 0 8px; padding: 0 0 0 22px; display: none; border-left: 1px solid var(--rh-line); margin-left: 21px; }
  .sb-li.abierto .sb-submenu { display: block; }
  .sb-sub-link { display: block; padding: 9px 12px; margin: 2px 0; border-radius: 8px; color: var(--rh-muted); text-decoration: none; font-size: 14px; font-weight: 500; transition: 0.2s; }
  .sb-sub-link:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }

  /* Activo: mismo estilo que el botón activo de la barra superior */
  .sb-link.activo { background: var(--rh-active-bg); border-color: var(--rh-active-border); color: #fff; }
  .sb-link.activo .sb-icon { color: #93c5fd; }
  .sb-sub-link.activo { color: #fff; font-weight: 700; background: #1d3b63; }

  .sb-footer { padding: 14px; border-top: 1px solid var(--rh-line); display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .sb-footer .rh-avatar { flex-shrink: 0; }
  .sb-footer__name { color: #fff; font-weight: 700; font-size: 14px; line-height: 1.2; }
  .sb-footer__rol { color: var(--rh-muted); font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }

  #sb-overlay-blindado { position: fixed; inset: 0; background: rgba(2, 8, 23, 0.55); z-index: 9998; display: none; }
  #sb-overlay-blindado.activo { display: block; }

  /* En escritorio el menú lateral no se usa */
  @media (min-width: 1200px) {
    #mi-sidebar-blindado, #sb-overlay-blindado { display: none !important; }
  }
</style>

<div id="sb-overlay-blindado"></div>

<aside id="mi-sidebar-blindado" aria-label="Menú principal">
  <div class="sb-header">
    <img src="/images/header/logo-recursos-hidricos-oscuro.png" alt="Administración Provincial de Recursos Hídricos" />
    <button type="button" class="sb-close" id="sb-close" aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <nav class="sb-nav">
    <span class="sb-label">Módulos del sistema</span>
    <ul class="sb-ul">
      <% _secciones.forEach(s => { const activa = _ubic.seccion && _ubic.seccion.id === s.id; %>
        <% if (s.items.length === 1) { %>
          <li class="sb-li">
            <a href="<%= s.items[0].href %>" class="sb-link<%= activa ? ' activo' : '' %>">
              <svg class="sb-icon" viewBox="0 0 24 24"><%- s.icono %></svg>
              <%= s.label %>
            </a>
          </li>
        <% } else { %>
          <li class="sb-li<%= activa ? ' abierto' : '' %>">
            <button type="button" class="sb-link<%= activa ? ' activo' : '' %>" onclick="this.parentElement.classList.toggle('abierto')">
              <svg class="sb-icon" viewBox="0 0 24 24"><%- s.icono %></svg>
              <%= s.label %>
              <svg class="sb-chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <ul class="sb-submenu">
              <% s.items.forEach(i => { %>
                <li><a href="<%= i.href %>" class="sb-sub-link<%= _ubic.item === i ? ' activo' : '' %>"><%= i.label %></a></li>
              <% }) %>
            </ul>
          </li>
        <% } %>
      <% }) %>
    </ul>
  </nav>

  <div class="sb-footer">
    <span class="rh-avatar"><%= _nav.iniciales(_usr) %></span>
    <div>
      <div class="sb-footer__name"><%= _usr ? (_usr.nombre + ' ' + _usr.apellido) : 'Administrador Sistema' %></div>
      <div class="sb-footer__rol"><%= _usr ? _usr.rol : 'Administrador' %></div>
    </div>
  </div>
</aside>

<script>
  (function () {
    const sidebar = document.getElementById('mi-sidebar-blindado');
    const overlay = document.getElementById('sb-overlay-blindado');
    const cerrar = () => { sidebar.classList.remove('abierto'); overlay.classList.remove('activo'); };
    overlay.addEventListener('click', cerrar);
    document.getElementById('sb-close').addEventListener('click', cerrar);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    // El botón ☰ está en la barra superior (topbar.ejs), que se dibuja después de este partial
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('menu-toggle');
      if (btn) btn.addEventListener('click', (e) => { e.preventDefault(); sidebar.classList.add('abierto'); overlay.classList.add('activo'); });
    });
  })();
</script>
